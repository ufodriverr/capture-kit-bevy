// The sample world: resource nodes, wild creature spawns, loot tables, missions and camp levels.
(
    // Resource nodes. hp < 0: picked up with F instead of broken. Each hit that takes `step` of the node's
    // HP drops one `batch` roll; breaking it drops `last`. Rolls: (item, min, max, chance).
    nodes: [
        (kind: Tree, hp: 600, defense: 2, batch: [("wood", 1, 1, 1.0), ("fiber", 1, 1, 0.25)], last: [("wood", 3, 3, 1.0), ("fiber", 1, 2, 1.0)]),
        (kind: Rock, hp: 1800, defense: 4, batch: [("stone", 1, 1, 1.0)], last: [("stone", 3, 3, 1.0)]),
        (kind: Crystal, hp: 900, defense: 2, batch: [("spark_shard", 1, 1, 1.0), ("stone", 1, 1, 0.5)], last: [("spark_shard", 2, 2, 1.0)]),
        (kind: Ore, hp: 3000, defense: 5, batch: [("copper_ore", 1, 1, 1.0), ("stone", 1, 1, 0.3)], last: [("copper_ore", 2, 2, 1.0)]),
        (kind: BerryBush, hp: -1, defense: 3, batch: [("berries", 1, 3, 1.0), ("berry_seeds", 1, 1, 0.35), ("mushroom", 1, 1, 0.2)], last: []),
        (kind: Pebble, hp: -1, defense: 3, batch: [("stone", 1, 2, 1.0)], last: []),
    ],
    // Wild creature herds: (creature, center (x, z) in metres, radius, count, (min level, max level)).
    spawns: [
        ("fluffin", (18.0, -18.0), 14.0, 4, (1, 3)),
        ("mossnut", (-25.0, 15.0), 12.0, 3, (2, 4)),
        ("sprigling", (40.0, 25.0), 15.0, 3, (3, 6)),
        ("kindlet", (-30.0, -40.0), 15.0, 3, (5, 9)),
        ("tinkit", (-95.0, 45.0), 18.0, 4, (8, 14)),
    ],
    // Loot tables: (item, weight, min, max). One row is picked by weight.
    loot: {
        "fluffin_ranch": [("fluff", 3.0, 1, 2), ("egg", 1.0, 1, 1)],
    },
    // The mission chain, in order. Goals: Have(item, count), Build(building), Unlock(tech), Craft(item),
    // Capture(count), Workers(count), Eat, Equip(item), SpendPoint, Level(level).
    missions: [
        (title: "Make Camp", text: "Gather some Wood. Hit trees or pick up branches.", goal: Have("wood", 10)),
        (title: "A Place to Work", text: "Open the build menu (B) and set up a Workbench.", goal: Build("workbench")),
        (title: "Shards of Light", text: "Break blue crystals to collect Spark Shards.", goal: Have("spark_shard", 3)),
        (title: "Orb Crafting", text: "Unlock Capture Orbs (T) and craft one at the Workbench.", goal: Craft("capture_orb")),
        (title: "First Friend", text: "Weaken a wild creature, then throw an orb at it (hold Q, release).", goal: Capture(1)),
        (title: "Home Base", text: "Build a Camp Core to found your camp.", goal: Build("camp_core")),
        (title: "Put Them to Work", text: "Assign a creature to the camp from the Camp Core.", goal: Workers(1)),
        (title: "Something to Eat", text: "Eat something from your bag. Cooked food fills you up more.", goal: Eat),
        (title: "Dress for the Weather", text: "Craft a Cloth Tunic and wear it.", goal: Equip("cloth_tunic")),
        (title: "Stronger Every Day", text: "Level up and spend a status point (Tab).", goal: SpendPoint),
    ],
    // Camp levels: how many creatures may live at the camp, and what it takes to reach the next level:
    // (level, max workers, needs: (workers, [(buildings, count)])). The last level has no needs.
    camp_levels: [
        (level: 1, workers: 3, needs: (workers: 1, builds: [(["workbench"], 1), (["storage_chest"], 1)])),
        (level: 2, workers: 4, needs: (workers: 2, builds: [(["feed_box"], 1), (["creature_bed"], 2)])),
        (level: 3, workers: 5, needs: (workers: 3, builds: [(["ranch", "berry_patch"], 1), (["campfire"], 1)])),
        (level: 4, workers: 6, needs: (workers: 4, builds: [(["stone_quarry", "lumber_yard"], 1), (["repair_bench"], 1)])),
        (level: 5, workers: 8),
    ],
)
